# Zuno Edge Function secrets - PLACEHOLDERS ONLY. Never commit real values.
# Local:      cp supabase/functions/.env.example supabase/.env   (then edit)
#             supabase functions serve --env-file supabase/.env
# Production: supabase secrets set --env-file ./prod.env   (or one by one, see docs/backend/SUPABASE_SETUP.md)

# Provided automatically by Supabase in hosted Edge Functions (set them only for local serving).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# NIC uniqueness (nic-digest). >= 32 random bytes. Accepts "base64:<...>", "hex:<...>" or a raw string.
# Generate: echo "base64:$(openssl rand -base64 48)"
NIC_HMAC_KEY=base64:REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64
NIC_HMAC_KEY_VERSION=1

# PayHere (payhere-checkout / payhere-notify)
PAYHERE_MERCHANT_ID=replace-with-merchant-id
PAYHERE_MERCHANT_SECRET=replace-with-merchant-secret
# sandbox | live
PAYHERE_MODE=sandbox
# Optional overrides (default: <SUPABASE_URL>/functions/v1/payhere-return and .../payhere-notify)
PAYHERE_RETURN_URL=
PAYHERE_NOTIFY_URL=
# Optional e-mail sent to PayHere when an account has no e-mail address (e.g. phone-only sign-in)
PAYHERE_FALLBACK_EMAIL=

# AI organizer co-pilot (Anthropic Messages API)
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
AI_MODEL=claude-opus-5-5
# Optional: output_config.effort (low|medium|high|xhigh|max|off), default low
AI_EFFORT=low
# Optional: server-side refusal fallbacks ("default" or "off"), default default
AI_FALLBACKS=default

# Apple Push Notification service (push-dispatch) - token-based auth
# APNS_KEY_P8 is the full .p8 file content; literal "\n" sequences are accepted.
APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_P8_KEY_BODY\n-----END PRIVATE KEY-----"
APNS_KEY_ID=REPLACEKID
APNS_TEAM_ID=REPLACETEAM
APNS_TOPIC=lk.zuno.app
# Default environment for devices without one: sandbox | production
APNS_ENV=sandbox

# Auth providers (read by supabase/config.toml via env(...))
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=replace-with-bundle-id-and-services-id
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=replace-with-apple-client-secret-jwt
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-ids
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-client-secret
