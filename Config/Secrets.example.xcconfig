// Copy to Config/Secrets.Development.xcconfig (or .Test / .Production) and fill in.
// These files are git-ignored. Only publishable values belong in the app:
// never put a service-role key, PayHere merchant secret, Apple private key,
// Google client secret or AI provider key here — those live in Supabase secrets.

ZUNO_DEVELOPMENT_TEAM = ABCDE12345
ZUNO_SUPABASE_HOST = your-project-ref.supabase.co
ZUNO_SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
ZUNO_GOOGLE_IOS_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
ZUNO_PAYHERE_RETURN_HOST = your-project-ref.supabase.co
